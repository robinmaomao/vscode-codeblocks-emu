			<Target title="Release">
				<Option type="1" />
				<Option compiler="gcc" />
				<Option output="bin/Release/hello" />
				<Option object_output="obj/Release/" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
			</Target>
		</Build>
		<Unit filename="main.c" />
		<Unit filename="util.c" />
		<Unit filename="util.h" />
		<Extensions />
	</Project>
