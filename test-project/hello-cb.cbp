<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="hello-cb" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option type="1" />
				<Option compiler="gcc" />
				<Option output="bin/Debug/hello" />
