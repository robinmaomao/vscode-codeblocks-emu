<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="fileprops-demo" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/fileprops-demo" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
			</Target>
			<Target title="Release">
				<Option output="bin/Release/fileprops-demo" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
			</Target>
		</Build>
		<Unit filename="include/guard.h">
			<Option compile="1" />
		</Unit>
		<Unit filename="src/main.c">
			<Option compilerVar="CC" />
			<Option weight="20" />
		</Unit>
		<Unit filename="src/util.cpp">
			<Option compiler="gcc" use="1" buildCommand="$compiler -E $file -o $object" />
			<Option target="Debug" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
